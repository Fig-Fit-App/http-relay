{
  "name": "@figfit-oss/http-relay",
  "version": "0.1.0",
  "description": "Typed client for the http-relay HTTPS proxy",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figfit-oss/http-relay.git",
    "directory": "packages/sdk"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
